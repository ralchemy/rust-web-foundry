set dotenv-load := true

infra-up:
    docker compose up -d --wait

infra-down:
    docker compose down

policy-stub:
    cargo run -p "{{ project-name }}" --example task-policy-stub

migrate:
    cargo run -p "{{ project-name }}" -- migrate

sqlx-prepare:
    #!/usr/bin/env bash
    set -euo pipefail
    database_url="${MIGRATION_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    SQLX_OFFLINE=false DATABASE_URL="$database_url" cargo sqlx migrate run --source crates/infrastructure/migrations
    SQLX_OFFLINE=false DATABASE_URL="$database_url" cargo sqlx prepare --workspace -- --all-targets --all-features

serve:
    cargo run -p "{{ project-name }}" -- serve

test:
    TEST_DATABASE_URL="${TEST_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}" cargo test --workspace --all-features --locked

architecture:
    #!/usr/bin/env bash
    set -euo pipefail
    direct_dependencies() {
      cargo tree -p "$1" --all-features --depth 1 --prefix none --format '{p}' --locked \
        | sed '1d; s/ .*//'
    }
    reject_dependencies() {
      package=$1
      shift
      dependencies=$(direct_dependencies "$package")
      for forbidden in "$@"; do
        if grep -Fxq "$forbidden" <<<"$dependencies"; then
          echo "$package must not depend on $forbidden" >&2
          exit 1
        fi
      done
    }
    reject_dependencies "{{ project-name }}-domain" \
      "{{ project-name }}-application" "{{ project-name }}-http" \
      "{{ project-name }}-infrastructure" "{{ project-name }}" \
      axum tokio sqlx reqwest serde fastrace logforth
    reject_dependencies "{{ project-name }}-application" \
      "{{ project-name }}-http" "{{ project-name }}-infrastructure" "{{ project-name }}" \
      axum tokio sqlx reqwest serde fastrace logforth
    reject_dependencies "{{ project-name }}-http" \
      "{{ project-name }}-infrastructure" "{{ project-name }}"
    reject_dependencies "{{ project-name }}-infrastructure" \
      "{{ project-name }}-http" "{{ project-name }}"
    while IFS= read -r file; do
      entry_points=$(grep -Ec '^[[:space:]]*pub[[:space:]]+(async[[:space:]]+)?fn[[:space:]]+execute[[:space:]]*\(' "$file" || true)
      if (( entry_points > 1 )); then
        echo "$file owns $entry_points public execute entry points; promote it to a directory module with one complete command per child" >&2
        exit 1
      fi
    done < <(find crates/application/src/use_cases -maxdepth 1 -type f -name '*.rs' ! -name 'mod.rs' -print)
    bash scripts/check-agent-context.sh

check: _check

ci: _check _accept

verify:
    #!/usr/bin/env bash
    set -euo pipefail
    cleanup() { docker compose down; }
    trap cleanup EXIT
    docker compose up -d --wait
    export DATABASE_URL="${DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export MIGRATION_DATABASE_URL="${MIGRATION_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export TEST_DATABASE_URL="${TEST_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export DEPLOYMENT_ENVIRONMENT="${DEPLOYMENT_ENVIRONMENT:-local}"
    export TASK_POLICY_URL="${TASK_POLICY_URL:-http://127.0.0.1:4001/check}"
    export TRACE_EXPORTER="${TRACE_EXPORTER:-console}"
    just ci

_check: architecture
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
    cargo test --workspace --exclude "{{ project-name }}" --all-features --locked
    cargo test -p "{{ project-name }}" --lib --bins --all-features --locked

_accept:
    #!/usr/bin/env bash
    set -euo pipefail
    export DATABASE_URL="${DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export MIGRATION_DATABASE_URL="${MIGRATION_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export TEST_DATABASE_URL="${TEST_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export DEPLOYMENT_ENVIRONMENT="${DEPLOYMENT_ENVIRONMENT:-local}"
    export HTTP_ADDR="${HTTP_ADDR:-127.0.0.1:3000}"
    export TASK_POLICY_URL="${TASK_POLICY_URL:-http://127.0.0.1:4001/check}"
    export TRACE_EXPORTER="${TRACE_EXPORTER:-console}"
    http_base="http://${HTTP_ADDR}"
    policy_log=$(mktemp)
    server_log=$(mktemp)
    policy_pid=
    server_pid=
    cleanup() {
      [[ -z "$server_pid" ]] || { kill "$server_pid" 2>/dev/null || true; wait "$server_pid" 2>/dev/null || true; }
      [[ -z "$policy_pid" ]] || { kill "$policy_pid" 2>/dev/null || true; wait "$policy_pid" 2>/dev/null || true; }
      rm -f "$policy_log" "$server_log"
    }
    trap cleanup EXIT
    cargo test -p "{{ project-name }}" --test create_task --all-features --locked
    cargo run -p "{{ project-name }}" --example task-policy-stub >"$policy_log" 2>&1 &
    policy_pid=$!
    for _ in {1..60}; do
      curl -sS -o /dev/null http://127.0.0.1:4001/health/live && break
      kill -0 "$policy_pid" 2>/dev/null || { cat "$policy_log"; exit 1; }
      sleep 0.5
    done
    curl -sS -o /dev/null http://127.0.0.1:4001/check
    cargo run -p "{{ project-name }}" -- migrate
    SQLX_OFFLINE=false DATABASE_URL="$MIGRATION_DATABASE_URL" cargo sqlx prepare --check --workspace -- --all-targets --all-features
    cargo run -p "{{ project-name }}" -- serve >"$server_log" 2>&1 &
    server_pid=$!
    for _ in {1..60}; do
      live_status=$(curl -sS -o /dev/null -w '%{http_code}' "$http_base/health/live" || true)
      [[ "$live_status" == 200 ]] && break
      kill -0 "$server_pid" 2>/dev/null || { cat "$server_log"; exit 1; }
      sleep 0.5
    done
    [[ "$(curl -sS -o /dev/null -w '%{http_code}' "$http_base/health/live")" == 200 ]]
    [[ "$(curl -sS -o /dev/null -w '%{http_code}' "$http_base/health/ready")" == 200 ]]
    response=$(curl -sS -w $'\n%{http_code}' -H 'content-type: application/json' -d '{"title":"  Smoke task  "}' "$http_base/api/v1/tasks")
    body=${response%$'\n'*}
    http_status=${response##*$'\n'}
    [[ "$http_status" == 201 ]]
    grep -Eq '"id":"[0-9A-HJKMNP-TV-Z]{26}"' <<<"$body"
    grep -Fq '"title":"Smoke task"' <<<"$body"
    kill -TERM "$server_pid"
    wait "$server_pid"
    server_pid=
    kill "$policy_pid"
    wait "$policy_pid" 2>/dev/null || true
    policy_pid=
    grep -Fq 'traceparent_present=true' "$policy_log"


lifecycle:
    #!/usr/bin/env bash
    set -euo pipefail
    export DATABASE_URL="${DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export MIGRATION_DATABASE_URL="${MIGRATION_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export TEST_DATABASE_URL="${TEST_DATABASE_URL:-mysql://app:app@127.0.0.1:3306/app}"
    export DEPLOYMENT_ENVIRONMENT="${DEPLOYMENT_ENVIRONMENT:-local}"
    export TASK_POLICY_URL="${TASK_POLICY_URL:-http://127.0.0.1:4001/check}"
    export TRACE_EXPORTER=none
    target_dir=$(cargo metadata --no-deps --format-version 1 | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')
    [[ -n "$target_dir" ]]
    cargo build -p "{{ project-name }}" --bin "{{ project-name }}" --example task-policy-stub --locked
    policy_bin="$target_dir/debug/examples/task-policy-stub"
    server_bin="$target_dir/debug/{{ project-name }}"
    [[ -x "$policy_bin" && -x "$server_bin" ]]
    policy_log=$(mktemp)
    gate=$(mktemp)
    server_log=$(mktemp)
    response_file=$(mktemp)
    timeout_response=$(mktemp)
    policy_pid=
    server_pid=
    request_pid=
    cleanup() {
      [[ -z "$request_pid" ]] || kill "$request_pid" 2>/dev/null || true
      [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null || true
      [[ -z "$policy_pid" ]] || kill "$policy_pid" 2>/dev/null || true
      [[ -z "$request_pid" ]] || wait "$request_pid" 2>/dev/null || true
      [[ -z "$server_pid" ]] || wait "$server_pid" 2>/dev/null || true
      [[ -z "$policy_pid" ]] || wait "$policy_pid" 2>/dev/null || true
      rm -f "$gate" "$policy_log" "$server_log" "$response_file" "$timeout_response"
    }
    trap cleanup EXIT

    touch "$gate"
    TASK_POLICY_STUB_BLOCK_FILE="$gate" "$policy_bin" >"$policy_log" 2>&1 &
    policy_pid=$!
    for _ in {1..60}; do
      if curl -fsS -o /dev/null http://127.0.0.1:4001/health/live; then break; fi
      kill -0 "$policy_pid" 2>/dev/null || { cat "$policy_log"; exit 1; }
      sleep 0.1
    done
    curl -fsS -o /dev/null http://127.0.0.1:4001/health/live

    HTTP_ADDR=127.0.0.1:3011 "$server_bin" serve >"$server_log" 2>&1 &
    server_pid=$!
    for _ in {1..100}; do
      if curl -fsS -o /dev/null http://127.0.0.1:3011/health/live; then break; fi
      kill -0 "$server_pid" 2>/dev/null || { cat "$server_log"; exit 1; }
      sleep 0.1
    done
    if ! curl -fsS -o /dev/null http://127.0.0.1:3011/health/live; then cat "$server_log"; exit 1; fi
    curl -fsS -o "$response_file" -H 'content-type: application/json' \
      -d '{"title":"drain task"}' http://127.0.0.1:3011/api/v1/tasks &
    request_pid=$!
    for _ in {1..100}; do
      grep -Fq 'task policy request received' "$policy_log" && break
      sleep 0.05
    done
    grep -Fq 'task policy request received' "$policy_log"
    kill -TERM "$server_pid"
    rm -f "$gate"
    wait "$request_pid"
    request_pid=
    wait "$server_pid"
    server_pid=
    grep -Fq '"title":"drain task"' "$response_file"

    : >"$policy_log"
    touch "$gate"
    SHUTDOWN_TIMEOUT_SECS=1 HTTP_ADDR=127.0.0.1:3012 "$server_bin" serve >"$server_log" 2>&1 &
    server_pid=$!
    for _ in {1..100}; do
      if curl -fsS -o /dev/null http://127.0.0.1:3012/health/live; then break; fi
      kill -0 "$server_pid" 2>/dev/null || { cat "$server_log"; exit 1; }
      sleep 0.1
    done
    if ! curl -fsS -o /dev/null http://127.0.0.1:3012/health/live; then cat "$server_log"; exit 1; fi
    curl -sS -o "$timeout_response" -w '%{http_code}' \
      -H 'content-type: application/json' -d '{"title":"timeout task"}' \
      http://127.0.0.1:3012/api/v1/tasks >"$response_file" &
    request_pid=$!
    for _ in {1..100}; do
      grep -Fq 'task policy request received' "$policy_log" && break
      sleep 0.05
    done
    grep -Fq 'task policy request received' "$policy_log"
    kill -TERM "$server_pid"
    wait "$server_pid" && { cat "$server_log"; echo 'shutdown timeout unexpectedly succeeded' >&2; exit 1; } || true
    server_pid=
    wait "$request_pid" || true
    request_pid=
    grep -Fq 'HTTP shutdown timed out' "$server_log"
    grep -Eq '^(503|000)$' "$response_file"
