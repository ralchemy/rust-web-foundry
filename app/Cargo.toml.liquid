[package]
name = "{{ project-name }}"
version.workspace = true
edition.workspace = true

[features]
default = []
reference-task = [
    "application/reference-task",
    "domain/reference-task",
    "http/reference-task",
    "infrastructure/reference-task",
]

[lib]
name = "app"

[[example]]
name = "task-policy-stub"
path = "examples/task_policy_stub.rs"
required-features = ["reference-task"]

[[test]]
name = "create_task"
path = "tests/create_task.rs"
required-features = ["reference-task"]

[dependencies]
application.workspace = true
axum.workspace = true
config.workspace = true
domain.workspace = true
dotenvy.workspace = true
fastrace.workspace = true
fastrace-opentelemetry.workspace = true
http.workspace = true
infrastructure.workspace = true
log.workspace = true
logforth.workspace = true
opentelemetry.workspace = true
opentelemetry-otlp.workspace = true
opentelemetry_sdk.workspace = true
secrecy.workspace = true
serde.workspace = true
sqlx.workspace = true
tokio.workspace = true

[dev-dependencies]
http-body-util.workspace = true
serde_json.workspace = true
tower.workspace = true
