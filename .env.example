# Copy to .env for local development. Existing process variables take precedence.
# Compose publishes its fixed development account on loopback only. In
# production, give serve a DML-only account and run migrations with separate
# credentials.
DATABASE_URL=mysql://app:app@127.0.0.1:3306/app
MIGRATION_DATABASE_URL=mysql://app:app@127.0.0.1:3306/app
TEST_DATABASE_URL=mysql://app:app@127.0.0.1:3306/app

HTTP_ADDR=127.0.0.1:3000
SHUTDOWN_TIMEOUT_SECS=30

# Required only when running with --features reference-task.
TASK_POLICY_URL=http://127.0.0.1:4001/check
TASK_POLICY_TIMEOUT_MS=2000

DEPLOYMENT_ENVIRONMENT=local
RUST_LOG=info
LOG_FORMAT=text
TRACE_EXPORTER=console

# Required only when TRACE_EXPORTER=otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
