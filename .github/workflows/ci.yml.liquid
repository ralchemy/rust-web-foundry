{% raw %}
name: CI

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-latest
    services:
      mysql:
        image: mysql:8.4
        env:
          MYSQL_DATABASE: app
          MYSQL_PASSWORD: app
          MYSQL_ROOT_PASSWORD: root
          MYSQL_USER: app
        ports:
          - 3306:3306
        options: >-
          --health-cmd "mysqladmin ping -h 127.0.0.1 -uapp -papp"
          --health-interval 2s
          --health-timeout 2s
          --health-retries 30
    env:
      DATABASE_URL: mysql://app:app@127.0.0.1:3306/app
      MIGRATION_DATABASE_URL: mysql://app:app@127.0.0.1:3306/app
      TEST_DATABASE_URL: mysql://app:app@127.0.0.1:3306/app
      DEPLOYMENT_ENVIRONMENT: ci
      LOG_FORMAT: text
      RUST_LOG: info
      TASK_POLICY_URL: http://127.0.0.1:4001/check
      TRACE_EXPORTER: console
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy,rustfmt
      - run: cargo install just --version 1.58.0 --locked
      - run: cargo install sqlx-cli --version 0.9.0 --locked --no-default-features --features rustls,mysql
      - run: just ci
{% endraw %}
